{
  "paths": {
    "input": "data/pdfs",
    "output": "data/output",
    "data_table": "data_table.json",
    "query_plan": "data/query_plan.json",
    "jobs": "data/jobs.json",
    "screening": "data/screening",
    "criteria": "screening_criteria.json",
    "prompts": "config/prompts",
    "parser": "config/parse_parameters.json",
    "mineru": "config/mineru.json"
  },
  "uploads": {
    "max_records": 50000,
    "max_pdf_bytes": 52428800,
    "max_screening_bytes": 20971520
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "log_level": "info",
    "shutdown_timeout": 180
  },
  "llm": {
    "provider": "openai_compatible",
    "model": "openai/gpt-oss-120b",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key_env": "GROQ_API_KEY",
    "max_workers": 2,
    "max_concurrent_requests": 2,
    "retries": 2,
    "timeout": 120.0,
    "retry_initial_seconds": 1.0,
    "retry_max_seconds": 60.0,
    "max_tokens": 1024,
    "token_parameter": "max_tokens",
    "temperature": 0.0,
    "json_mode": true,
    "planner_batch_size": 4,
    "max_group_evidence_chunks": 24
  },
  "chunking": {
    "tokenizer": "cl100k_base",
    "max_tokens": 256,
    "min_tokens": 5,
    "overlap_tokens": 50,
    "caption_max_tokens": 45,
    "chunk_level": "paragraph"
  },
  "retrieval": {
    "candidates_per_query": 25,
    "use_prefilter": true,
    "rerank_top_k_per_query": 4,
    "max_evidence_chunks": 12,
    "max_fused_candidates": 100,
    "rrf_k": 60,
    "fusion_reserve": 4,
    "keyword_searcher": "bm25",
    "language": "english"
  },
  "embedding": {
    "service_url": null,
    "model": "BAAI/bge-m3",
    "revision": "5617a9f61b028005a4858fdac845db406aefb181",
    "batch_size": 32,
    "device": null,
    "api_key_env": "",
    "retries": 2,
    "query_prefix": "",
    "doc_prefix": "",
    "timeout": 30.0
  },
  "reranker": {
    "device": null,
    "retries": 2,
    "api_key_env": "",
    "service_url": null,
    "model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "revision": "233902d25c440f23af6f7d6e94d2946bac0bee0a",
    "timeout": 30.0
  },
  "nli": {
    "device": null,
    "model": "MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli",
    "revision": null,
    "batch_size": 8
  },
  "splade": {
    "model": "naver/splade-cocondenser-ensembledistil",
    "revision": null,
    "batch_size": 16,
    "max_length": 256
  },
  "full_extraction": {
    "tokenizer": "cl100k_base",
    "max_context_tokens": 7800,
    "max_tokens": 1536
  },
  "execution": {
    "warm_models": false,
    "max_concurrent_papers": 1,
    "mineru_batch_size": 10,
    "job_history_limit": 500
  },
  "screening": {
    "backend": "llm",
    "llm": {
      "provider": "openai_compatible",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_env": "GROQ_API_KEY",
      "structured_output": "json_schema",
      "token_parameter": "max_completion_tokens",
      "think": null,
      "reasoning_effort": "low",
      "model": "openai/gpt-oss-20b",
      "cache_revision": "groq-openai-gpt-oss-20b",
      "instructions": "config/prompts/screening_all_criteria_system.txt",
      "criterion_instructions": "config/prompts/screening_per_criterion_system.txt",
      "execution_mode": "per_criterion",
      "allow_uncertainty": false,
      "include_reason": true,
      "extract_evidence": false,
      "include_confidence_score": false,
      "temperature": 0.0,
      "context_tokens": 8192,
      "max_output_tokens": 512,
      "output_token_retry_multiplier": 2.0,
      "template_token_reserve": 256,
      "timeout": 120.0,
      "retries": 2,
      "response_retries": 1,
      "max_concurrent_requests": 1,
      "retry_initial_seconds": 1.0,
      "retry_max_seconds": 30.0,
      "keep_alive": "5m"
    },
    "panel": {
      "enabled": false,
      "second_reviewer": {
        "kind": "human",
        "llm": null
      },
      "judge": {
        "kind": "human",
        "llm": null
      },
      "judge_instructions": "config/prompts/screening_judge_system.txt",
      "require_judge_reason": true
    },
    "calibration": {
      "diagnostic_min_papers": 10,
      "neutral_rate_threshold": 0.5,
      "uncertain_rate_threshold": 0.3,
      "min_reviews": 20,
      "max_disagreement_rate": 0.0,
      "bootstrap_enabled": false,
      "bootstrap_samples": 100,
      "random_seed": 0,
      "max_threshold_spread": 0.1
    },
    "confidence_threshold": 0.8,
    "checkpoint_batch_size": 32
  }
}
